---
import Base from "../layouts/Base.astro";
---

<Base title="Linuxoria: find the Linux that feels like yours">
  <main class="wrap-narrow">
    <p class="eyebrow">Switching to Linux?</p>
    <h1>Find the Linux that feels like yours</h1>
    <p class="lede">
      Answer six quick questions and we’ll point you to the distros that fit how you actually use
      your computer. No account, nothing to install.
    </p>
    <p style="margin-top: 32px; display: flex; gap: 20px; flex-wrap: wrap; align-items: center">
      <a class="btn btn-primary" href="/quiz/">Start the quiz</a>
      <a class="link-accent" href="/distros/">Or browse all distros</a>
    </p>
  </main>
</Base>
